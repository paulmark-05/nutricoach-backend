5:32:46 PM [express] POST /api/recipes/generate 200 in 15400ms :: [{"title":"Avocado Toast with Poached Egg","ingredients":["1 slice whole-wheat bread","1/2 ripe avocado","1 large egg","Pinch of sea salt","Pinch of black pepper","Optional: red pepper flakes for garnish"],"instructions":"1. Toast the whole-wheat bread until golden. 2. While the bread is toasting, mash the ripe avocado in a small bowl. 3. Poach the egg to your desired doneness (approximately 3-4 minutes for a runny yolk). 4. Spread the mashed avocado evenly over the toasted bread. 5. Carefully place the poached egg on top of the avocado. 6. Season with salt, pepper, and red pepper flakes if using. Serve immediately.","macros":{"calories":260,"protein":11,"carbs":21,"fats":16}},{"title":"Egg and Veggie Scramble Sandwich","ingredients":["2 large eggs","1 slice whole-wheat bread","1/4 cup chopped bell pepper (any color)","1/4 cup fresh spinach, roughly chopped","1 teaspoon olive oil","Pinch of salt","Pinch of black pepper"],"instructions":"1. Heat olive oil in a non-stick pan over medium heat. 2. Add chopped bell pepper and sauté for 2-3 minutes until slightly softened. 3. Add spinach and cook until wilted, about 1 minute. 4. In a separate bowl, whisk the eggs with salt and pepper. 5. Pour the whisked eggs into the pan with the vegetables. Scramble until cooked through to your preference. 6. Toast the whole-wheat bread. 7. Place the egg and veggie scramble onto the toasted bread. Serve open-faced or as a sandwich.","macros":{"calories":275,"protein":17,"carbs":18,"fats":15}},{"title":"Healthy Cinnamon French Toast with Berries","ingredients":["1 slice whole-wheat bread","1 large egg","1/4 cup skim milk","1/4 teaspoon ground cinnamon","1/2 cup mixed fresh berries (e.g., blueberries, raspberries)","Optional: 1 teaspoon pure maple syrup"],"instructions":"1. In a shallow dish, whisk together the egg, skim milk, and ground cinnamon until well combined. 2. Dip the slice of whole-wheat bread into the egg mixture, ensuring both sides are fully coated but not soggy. 3. Heat a non-stick pan or griddle over medium heat (lightly grease if necessary). 4. Place the bread in the hot pan and cook for 2-3 minutes per side, or until golden brown and cooked through. 5. Transfer the French toast to a plate. Top with fresh mixed berries and drizzle with maple syrup if desired. Serve warm.","macros":{"calories":227,"protein":13,"carbs":32,"fats":6}},{"title":"Open-Faced Greek Yogurt Egg Salad Sandwich","ingredients":["2 hard-boiled large eggs","1 slice whole-wheat bread","2 tablespoons plain non-fat Greek yogurt","1 teaspoon Dijon mustard","Pinch of salt","Pinch of black pepper","Optional: 1 tablespoon chopped fresh chives or dill"],"instructions":"1. Peel and chop the hard-boiled eggs into small pieces. 2. In a small bowl, combine the chopped eggs, Greek yogurt, Dijon mustard, salt, pepper, and optional chives/dill. Mix well until everything is incorporated. 3. Toast the whole-wheat bread to your preference. 4. Spread the egg salad mixture evenly over the toasted bread. Serve immediately.","macros":{"calories":235,"protein":19,"carbs":16,"fats":11}},{"title":"Baked Egg in Bread Cup","ingredients":["1 slice whole-wheat bread","1 large egg","1 tablespoon shredded low-fat cheese (e.g., mozzarella or cheddar)","Pinch of salt","Pinch of black pepper","Cooking spray"],"instructions":"1. Preheat your oven to 375°F (190°C). Lightly grease one cup of a muffin tin with cooking spray. 2. Using a rolling pin, flatten the slice of whole-wheat bread slightly. 3. Carefully press the flattened bread into the greased muffin cup, forming a 'cup' or nest. 4. Gently crack the large egg directly into the bread cup. 5. Sprinkle with salt, pepper, and shredded low-fat cheese. 6. Bake for 12-15 minutes, or until the egg whites are set and the yolk reaches your desired doneness. 7. Carefully remove from the muffin tin and serve warm.","macros":{"calories":180,"protein":13,"carbs":16,"fats":8}}]
